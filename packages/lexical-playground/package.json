    "@lexical/code": "0.30.0",
    "@lexical/file": "0.30.0",
    "@lexical/hashtag": "0.30.0",
    "@lexical/link": "0.30.0",
    "@lexical/list": "0.30.0",
    "@lexical/mark": "0.30.0",
    "@lexical/overflow": "0.30.0",
    "@lexical/plain-text": "0.30.0",
    "@lexical/react": "0.30.0",
    "@lexical/rich-text": "0.30.0",
    "@lexical/selection": "0.30.0",
    "@lexical/table": "0.30.0",
    "@lexical/text": "^0.30.0",
    "@lexical/utils": "0.30.0",
    "@lexical/yjs": "^0.30.0",
    "katex": "^0.16.10",
    "lexical": "0.30.0",
    "lodash-es": "^4.17.21",
    "onchain-lexical-context": "^0.0.12",
    "onchain-lexical-instance": "^0.0.14",
    "onchain-lexical-markdown": "^0.0.13",
    "onchain-lexical-ui": "^0.0.12",
    "onchain-utility": "^0.0.10",
    "prettier": "^2.8.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^3.1.4",
    "vite-plugin-style-inject": "^0.0.1",
    "y-websocket": "^1.5.4",
    "yjs": ">=13.5.42"
  },
  "devDependencies": {
    "@babel/plugin-transform-flow-strip-types": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@types/lodash-es": "^4.14.182",
    "@vitejs/plugin-react": "^4.2.1",
    "code-inspector-plugin": "^0.20.10",
    "rollup-plugin-copy": "^3.5.0",
    "vite": "^7.1.4",
    "vite-plugin-static-copy": "^2.3.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./lib/index.es.mjs"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./lib/index.cjs.mjs"
      }
    }
  }
